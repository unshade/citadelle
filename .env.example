# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── Database ───────────────────────────────────────────────────────────────────
DB_PATH=citadelle.db

# ── Auth ───────────────────────────────────────────────────────────────────────
# Required - generate a strong secret for production (min 32 chars)
JWT_SECRET=dev-secret-change-me-in-production-min-32-chars

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
# Development: use your local frontend URL
# Production: use your actual domain(s)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
